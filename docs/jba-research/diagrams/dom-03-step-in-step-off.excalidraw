      "type": "text",
      "x": 62,
      "y": 334,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Tell the study to paint only on a completed bar, and the arrow lands where that bar OPENED — not where price is now.",
      "fontSize": 13,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
      "updatedAt": "2026-08-29T18:56:00.352Z",
