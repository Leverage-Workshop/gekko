      "y": 204,
      "width": 240,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Nothing on the chart yet. The\nstudy refuses to commit on the\nfirst tick of a bar.",
      "fontSize": 12.5,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
      "updatedAt": "2026-08-29T18:56:00.352Z",
