    {
      "id": "l_b4c",
      "type": "text",
      "x": 899,
      "y": 204,
      "width": 240,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"it will step off if that anomaly is\nno longer met\" — DD @12:30.\nThe arrow you saw a minute ago\nmay simply not be there.",
      "fontSize": 12.5,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
