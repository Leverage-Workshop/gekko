      "strokeWidth": 2,
      "roughness": 0,
      "text": "2   20% of the zone trades",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
      "updatedAt": "2026-08-29T18:56:27.294Z",
      "version": 2
    },
    {
      "id": "l_b2c",
      "type": "text",
      "x": 329,
      "y": 204,
      "width": 240,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The gate. \"requiring 20% of that\nvolume activity ... in that zone to\noccur in order to print to begin\nwith\" — DD @12:46",
      "fontSize": 12.5,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
      "updatedAt": "2026-08-29T18:56:00.352Z",
      "version": 1
