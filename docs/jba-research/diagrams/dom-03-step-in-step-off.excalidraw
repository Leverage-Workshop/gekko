    {
      "id": "l_title",
      "type": "text",
      "x": 40,
      "y": 30,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The arrow is alive: it steps in, and it steps off",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
      "updatedAt": "2026-08-29T18:56:00.352Z",
      "version": 1
    },
    {
      "id": "l_sub",
      "type": "text",
      "x": 40,
      "y": 72,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A Dominator print is a live reading, not a permanent mark on history — and one setting throws that away.",
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:56:00.352Z",
      "updatedAt": "2026-08-29T18:56:00.352Z",
      "version": 1
    },
    {
