    {
      "id": "w5_b7",
      "type": "rectangle",
      "x": 910,
      "y": 244,
      "width": 135,
      "height": 160,
      "backgroundColor": "#ffc9c9",
      "strokeColor": "#e03131",
      "strokeWidth": 2,
