    },
    {
      "id": "w5_ctxt",
      "type": "text",
      "x": 56,
      "y": 440,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Who you watch, in order: first the OPPONENT (the buyers, for a short) — refreshing = wait, dwindling = get ready, gone = go. Then YOUR OWN side (the offer) —\nheavy and filling = the trade is fine, thinning = out. The box edge is the stop; the first structure inside the box is the first extraction; the far edge is where the runner goes.",
      "fontSize": 13,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:25:45.465Z",
      "updatedAt": "2026-09-06T19:25:45.465Z",
      "version": 1
    }
  ],
