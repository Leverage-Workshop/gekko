    {
      "id": "p_at",
      "type": "text",
      "x": 102,
      "y": 408,
      "strokeColor": "#e03131",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "ABSORPTION",
      "fontSize": 22,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_at2",
      "type": "text",
      "x": 102,
      "y": 442,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The resting side is winning. Effort spent,",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_at3",
      "type": "text",
      "x": 102,
      "y": 464,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "nothing bought with it.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_at4",
      "type": "text",
      "x": 102,
      "y": 500,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "delta profile  —  thick one-colour block",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_at5",
      "type": "text",
      "x": 102,
      "y": 522,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "DOM  —  eaten, refilled, price frozen",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_at6",
      "type": "text",
      "x": 102,
      "y": 544,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "tape  —  sweeps going nowhere",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_at7",
      "type": "text",
      "x": 102,
      "y": 574,
      "strokeColor": "#e03131",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Takes time. A reason to wait, not to enter.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
