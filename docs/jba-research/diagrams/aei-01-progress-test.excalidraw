    {
      "id": "p_it",
      "type": "text",
      "x": 652,
      "y": 408,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "INITIATIVE",
      "fontSize": 22,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_it2",
      "type": "text",
      "x": 652,
      "y": 442,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The aggressors are getting paid. Effort",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.009Z",
      "updatedAt": "2026-08-29T18:33:17.009Z",
      "version": 1
    },
    {
      "id": "p_it3",
      "type": "text",
      "x": 652,
      "y": 464,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "spent, ground taken.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_it4",
      "type": "text",
      "x": 652,
      "y": 500,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "delta profile  —  barely registers, thin bins",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_it5",
      "type": "text",
      "x": 652,
      "y": 522,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "DOM  —  orders walking the ladder",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_it6",
      "type": "text",
      "x": 652,
      "y": 544,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "tape  —  sweeps that progress",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_it7",
      "type": "text",
      "x": 652,
      "y": 574,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "What you want AFTER you are positioned.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_x",
      "type": "rectangle",
      "x": 80,
      "y": 648,
      "width": 1010,
      "height": 128,
      "backgroundColor": "#e9ecef",
      "strokeColor": "#868e96",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
