      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_xt",
      "type": "text",
      "x": 102,
      "y": 664,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "EXHAUSTION is not on this fork.",
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_xt2",
      "type": "text",
      "x": 102,
      "y": 700,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "It is not a live read at all. It is a claim about the move that already finished — a thin node, a parabolic taper,",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_xt3",
      "type": "text",
      "x": 102,
      "y": 722,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "a blowoff, left behind on the volume profile. Decided on the chart, and decided before you look at the ladder",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    },
    {
      "id": "p_xt4",
      "type": "text",
      "x": 102,
      "y": 744,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "at all:  \"there's no reason for me to have my eyes on the dom\"  —  07-17 @07:45",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:33:17.010Z",
      "updatedAt": "2026-08-29T18:33:17.010Z",
      "version": 1
    }
