    },
    {
      "id": "f_calltx",
      "type": "text",
      "x": 52,
      "y": 548,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A flip is a relocation, not a wobble. The Gekko study only counts it when the POC lands 20+ points from where it was, and evaluates nothing\nin the first two minutes of a period — \"especially if it's in the first 2 minutes, you're looking at a 2-minute candle POC\" (04-30 @31:49).\nHow soon you see it also depends on compression: Job runs 4 ticks per bin, to match his DOM (07-17 @06:21).",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:45:36.074Z",
      "updatedAt": "2026-08-29T05:45:36.074Z",
      "version": 1
    }
