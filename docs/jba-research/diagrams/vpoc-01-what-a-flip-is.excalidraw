    {
      "id": "f_s1",
      "type": "text",
      "x": 48,
      "y": 126,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "1 · The POC sits at one node\nBusiness gets done at one price.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:45:36.072Z",
      "updatedAt": "2026-08-29T05:45:36.072Z",
      "version": 1
    },
    {
      "id": "f_s2",
      "type": "text",
      "x": 443,
      "y": 126,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "2 · Volume builds somewhere else\nThe old node is still the POC.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:45:36.072Z",
      "updatedAt": "2026-08-29T05:45:36.072Z",
      "version": 1
    },
    {
      "id": "f_s3",
      "type": "text",
      "x": 838,
      "y": 126,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "3 · The new node out-trades it\nThe POC relocates. That is the flip.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:45:36.072Z",
      "updatedAt": "2026-08-29T05:45:36.072Z",
      "version": 1
    },
