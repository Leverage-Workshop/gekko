  "elements": [
    {
      "id": "f_title",
      "type": "text",
      "x": 30,
      "y": 30,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "What a VPOC flip is",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:45:36.071Z",
      "updatedAt": "2026-08-29T05:45:36.071Z",
      "version": 1
    },
    {
      "id": "f_sub",
      "type": "text",
      "x": 30,
      "y": 68,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Nobody moves the line. The line moves because the crowd moved.   (bars = volume traded at each price; higher price at the top)",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:45:36.071Z",
      "updatedAt": "2026-08-29T05:45:36.071Z",
      "version": 1
    },
    {
      "id": "f_p1",
      "type": "rectangle",
      "x": 30,
      "y": 110,
      "width": 340,
      "height": 390,
