    {
      "id": "r_ctxt2",
      "type": "text",
      "x": 56,
      "y": 510,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Base rate: \"For the most part, we're going to have a lot of mechanical activity.\" (DD @16:27)   And a tag is not control:\n\"unless we're building below it, the control is not there. Unless we're building above it, if price is below, the control is not above it.\" (DD @13:29)",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:58.428Z",
      "updatedAt": "2026-09-06T19:21:58.428Z",
      "version": 1
    }
