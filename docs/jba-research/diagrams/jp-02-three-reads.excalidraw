    },
    {
      "id": "r_at1",
      "type": "text",
      "x": 72,
      "y": 428,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Trade the response. Rebid above /\nreoffer below, risk against the level.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
      "updatedAt": "2026-09-06T19:21:32.137Z",
      "version": 1
    },
    {
      "id": "r_a2",
      "type": "rectangle",
      "x": 420,
      "y": 420,
      "width": 280,
      "height": 48,
      "backgroundColor": "#ffc9c9",
      "strokeColor": "#e03131",
      "strokeWidth": 2,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
