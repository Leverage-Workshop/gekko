    {
      "id": "r_at3",
      "type": "text",
      "x": 792,
      "y": 428,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Play the edges, nothing in the middle.\n\"let the pendulum swing\"",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
      "updatedAt": "2026-09-06T19:21:32.137Z",
