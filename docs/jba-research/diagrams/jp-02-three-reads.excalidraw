    {
      "id": "r_d1",
      "type": "text",
      "x": 60,
      "y": 362,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Tags it, pauses, responds.\nThe inventory is home.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
      "updatedAt": "2026-09-06T19:21:32.137Z",
      "version": 1
    },
    {
      "id": "r_d2",
      "type": "text",
      "x": 420,
      "y": 362,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Slices through, then speeds up.\n\"There's another player at hand.\"",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
      "updatedAt": "2026-09-06T19:21:32.137Z",
      "version": 1
    },
    {
      "id": "r_d3",
      "type": "text",
      "x": 780,
      "y": 362,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Turns at each side of value,\nrotates through the pivot.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
      "updatedAt": "2026-09-06T19:21:32.137Z",
      "version": 1
    },
    {
      "id": "r_a1",
      "type": "rectangle",
      "x": 60,
