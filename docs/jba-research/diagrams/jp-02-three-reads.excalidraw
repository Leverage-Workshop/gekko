    },
    {
      "id": "r_at2",
      "type": "text",
      "x": 432,
      "y": 428,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Do NOT counter it. Stand aside.\n\"no point in countering this\"",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:21:32.137Z",
      "updatedAt": "2026-09-06T19:21:32.137Z",
      "version": 1
    },
    {
