      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945883826,
      "link": null,
      "locked": false,
      "text": "\"Watch these 66s.\nThey're refreshing.\nRefreshing. Refreshing.\"",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Watch these 66s.\nThey're refreshing.\nRefreshing. Refreshing.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w_n1",
      "type": "text",
      "x": 58,
      "y": 440,
      "width": 199.54644775390625,
      "height": 56.25,
