      "versionNonce": 930355153,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945883826,
      "link": null,
      "locked": false,
      "text": "\"When we ultimately step\nabove the 66s and the offer\nsteps away, you're going to\nsee the opposite, where the\nbid begins to step in and\nrefresh.\"",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"When we ultimately step\nabove the 66s and the offer\nsteps away, you're going to\nsee the opposite, where the\nbid begins to step in and\nrefresh.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "w_n2",
      "type": "text",
      "x": 398,
      "y": 440,
      "width": 209.70144653320312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
