      "versionNonce": 990907953,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945911209,
      "link": null,
      "locked": false,
      "text": "The sell wall goes, and the\nbuyers take over the\nrefreshing. That is the swap\nto watch for.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The sell wall goes, and the\nbuyers take over the\nrefreshing. That is the swap\nto watch for.",
      "autoResize": true,
      "lineHeight": 1.25
    },
