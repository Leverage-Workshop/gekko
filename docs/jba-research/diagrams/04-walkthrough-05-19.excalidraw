      "versionNonce": 1791061681,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945909640,
      "link": null,
      "locked": false,
      "text": "Price keeps trying and\ncannot get above the level.\nEvery push is absorbed.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Price keeps trying and\ncannot get above the level.\nEvery push is absorbed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
