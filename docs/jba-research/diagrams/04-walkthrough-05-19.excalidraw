      "boundElements": null,
      "updated": 1787945883826,
      "link": null,
      "locked": false,
      "text": "The lesson: refreshing by itself is never the signal. The SWAP is — the moment your opponent stops refreshing and your own side starts.",
      "fontSize": 17,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The lesson: refreshing by itself is never the signal. The SWAP is — the moment your opponent stops refreshing and your own side starts.",
