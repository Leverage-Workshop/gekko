      "boundElements": null,
      "updated": 1787945883826,
      "link": null,
      "locked": false,
      "text": "The cleanest single example in the corpus. Watch it in one go: sellers defend, sellers leave, buyers take over the defending — and that handoff is the trade.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The cleanest single example in the corpus. Watch it in one go: sellers defend, sellers leave, buyers take over the defending — and that handoff is the trade.",
      "autoResize": true,
      "lineHeight": 1.25
    },
