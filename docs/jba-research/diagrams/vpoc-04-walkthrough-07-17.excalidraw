      "version": 1
    },
    {
      "id": "w_t6",
      "type": "text",
      "x": 830,
      "y": 418,
      "strokeColor": "#d9480f",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "6 · @22:09   the old POC is the target",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:50:21.987Z",
      "updatedAt": "2026-08-29T05:50:21.987Z",
      "version": 1
    },
    {
      "id": "w_b6",
      "type": "text",
      "x": 830,
      "y": 450,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"next logical place of a pock was back to\nwhere it was the 410s... and so the 410s\nis ultimately a target on that.\"\n\nAnd when it gets there (@22:26): \"take it\noff the table, because at that point\nshifting pock back to the upper portion of\nvalue... now you potentially enter two-way trade.\"",
      "fontSize": 13,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:50:21.987Z",
      "updatedAt": "2026-08-29T05:50:21.987Z",
      "version": 1
    },
