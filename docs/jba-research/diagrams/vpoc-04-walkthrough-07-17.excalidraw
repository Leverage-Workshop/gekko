    },
    {
      "id": "w_calltx",
      "type": "text",
      "x": 52,
      "y": 660,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "His own summary, at @20:38:  \"on the fly with a directional move down and through this, this is what I'm looking for as far as pock flip.\nGive me some sort of exhaustive look on this to be able to get in and extract with minimal risk, as minimal as possible.\"",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:50:21.987Z",
      "updatedAt": "2026-08-29T05:50:21.987Z",
      "version": 1
    }
