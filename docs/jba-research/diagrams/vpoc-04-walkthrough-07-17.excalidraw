    {
      "id": "w_c6",
      "type": "rectangle",
      "x": 810,
      "y": 400,
      "width": 360,
      "height": 200,
      "backgroundColor": "#fff4e6",
      "strokeColor": "#e8590c",
      "strokeWidth": 2,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
