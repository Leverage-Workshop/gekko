      "updatedAt": "2026-08-29T05:47:59.963Z",
      "version": 1
    },
    {
      "id": "g_calltx",
      "type": "text",
      "x": 52,
      "y": 669,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Member: \"if it's at the extremes of a period, then you're looking to basically trade away from that level, so reversion from that level.\nWhereas, if it's in the middle of the period, then you're looking for a rotational behavior around the POC. Is that right?\"\nJob: \"That's correct. Yep.\"                                                                                                                                                                   — 04-30 @30:15",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:47:59.963Z",
      "updatedAt": "2026-08-29T05:47:59.963Z",
      "version": 1
    },
