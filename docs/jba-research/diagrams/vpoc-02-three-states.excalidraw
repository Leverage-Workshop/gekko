    {
      "id": "g_v1",
      "type": "text",
      "x": 48,
      "y": 510,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "crowded → expect the push UP\nThe sellers who did all that\nbusiness are stranded below.\nLongs are the side the gate is\nopen for.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:47:59.963Z",
      "updatedAt": "2026-08-29T05:47:59.963Z",
      "version": 1
    },
    {
      "id": "g_v2",
      "type": "text",
      "x": 443,
      "y": 510,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "two-way trade → no direction\nNobody has been pinned. Wait\nfor it to pick a side, or trade the\nrotation around it. The study\nprints a grey diamond, no arrow.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:47:59.963Z",
      "updatedAt": "2026-08-29T05:47:59.963Z",
      "version": 1
    },
    {
      "id": "g_v3",
      "type": "text",
      "x": 838,
      "y": 510,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "crowded → expect the push DOWN\nThe longs who did all that\nbusiness are stranded above.\nShorts are the side the gate is\nopen for.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:47:59.963Z",
      "updatedAt": "2026-08-29T05:47:59.963Z",
      "version": 1
    },
    {
      "id": "g_call",
      "type": "rectangle",
      "x": 30,
      "y": 650,
      "width": 1130,
      "height": 92,
      "backgroundColor": "#e9ecef",
      "strokeColor": "#adb5bd",
      "strokeWidth": 2,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
