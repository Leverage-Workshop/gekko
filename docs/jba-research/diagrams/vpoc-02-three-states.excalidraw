      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The gate: three states, three postures",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:47:59.959Z",
      "updatedAt": "2026-08-29T05:47:59.959Z",
      "version": 1
    },
    {
      "id": "g_sub",
      "type": "text",
      "x": 30,
      "y": 68,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Where the VPOC sits inside the period's own high-to-low range is the whole read — and the expected push is AWAY from where it landed.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T05:47:59.959Z",
      "updatedAt": "2026-08-29T05:47:59.959Z",
      "version": 1
