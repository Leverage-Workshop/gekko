      "text": "THEY STEP AWAY   —   GREEN LIGHT    ",
      "fontSize": 22,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THEY STEP AWAY   —   GREEN LIGHT    ",
