      "versionNonce": 743125397,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945779009,
      "link": null,
      "locked": false,
      "text": "The size just stops coming back. Nobody is home. Your\nopponent has left the level, and there is nothing standing\nbetween price and the next area.\n\nTHIS IS THE ENTRY. \"When do you step in? When they\nstep away.\"",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The size just stops coming back. Nobody is home. Your\nopponent has left the level, and there is nothing standing\nbetween price and the next area.\n\nTHIS IS THE ENTRY. \"When do you step in? When they\nstep away.\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
