      "updated": 1787945779009,
      "link": null,
      "locked": false,
      "text": "The wall does not simply \"stop\". It either walks away from the level, or it turns around and comes at you. Job distinguishes these carefully.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The wall does not simply \"stop\". It either walks away from the level, or it turns around and comes at you. Job distinguishes these carefully.",
      "autoResize": true,
      "lineHeight": 1.25
    },
