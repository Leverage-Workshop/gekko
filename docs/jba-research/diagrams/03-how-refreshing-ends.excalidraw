      "boundElements": null,
      "updated": 1787945779009,
      "link": null,
      "locked": false,
      "text": "They no longer just hold 21587. They stack sells at 21585,\nthen 21583, chasing price down and protecting each new\nlevel on the way.\n\nThat is active, initiative selling. It kills the long outright —\nthis is worse than refreshing, not better.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "They no longer just hold 21587. They stack sells at 21585,\nthen 21583, chasing price down and protecting each new\nlevel on the way.\n\nThat is active, initiative selling. It kills the long outright —\nthis is worse than refreshing, not better.",
      "autoResize": true,
      "lineHeight": 1.25
    },
