      "text": "How refreshing ends — two endings, and only one is your green light    ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How refreshing ends — two endings, and only one is your green light    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
