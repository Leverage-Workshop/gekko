    {
      "id": "f_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Where price is × what it did. Two of these look alike on a chart and call for opposite actions.",
