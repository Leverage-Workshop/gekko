      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Three silhouettes on the delta profile",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.964Z",
      "updatedAt": "2026-08-29T18:37:19.964Z",
      "version": 1
    },
    {
      "id": "x_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "One bar per price bin, length = net aggressor volume. Price runs down the page. The shape is the read.",
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.964Z",
      "updatedAt": "2026-08-29T18:37:19.964Z",
      "version": 1
    },
    {
