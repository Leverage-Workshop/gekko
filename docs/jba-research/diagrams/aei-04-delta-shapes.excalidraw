    {
      "id": "x_c3a",
      "type": "text",
      "x": 800,
      "y": 404,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Price is travelling, so the effort is spread",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_c3b",
      "type": "text",
      "x": 800,
      "y": 426,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "thin. Read this one on the tape instead.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_c3c",
      "type": "text",
      "x": 800,
      "y": 456,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The delta profile records where effort got stuck.",
      "fontSize": 13,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_c1a2",
      "type": "text",
      "x": 60,
      "y": 404,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A run of same-sign bins at adjacent prices",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:38:05.523Z",
      "updatedAt": "2026-08-29T18:38:05.523Z",
      "version": 1
    },
    {
      "id": "x_c1b2",
      "type": "text",
      "x": 60,
      "y": 426,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "— and the band is still standing afterwards.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:38:05.523Z",
      "updatedAt": "2026-08-29T18:38:05.523Z",
