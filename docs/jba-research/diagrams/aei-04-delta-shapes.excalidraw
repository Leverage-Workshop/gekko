    {
      "id": "x_c2a",
      "type": "text",
      "x": 425,
      "y": 404,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"giant and blue, blue, blue. And we're not",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_c2b",
      "type": "text",
      "x": 425,
      "y": 426,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "making progress.\"  Then it runs out.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_c2c",
      "type": "text",
      "x": 425,
      "y": 456,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Job's word for the fat part: the exhausted bubble",
      "fontSize": 13,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_t3",
      "type": "text",
      "x": 800,
      "y": 122,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "INITIATIVE  —  barely there",
      "fontSize": 19,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
      "version": 1
    },
    {
      "id": "x_s3",
      "type": "text",
      "x": 800,
      "y": 150,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "nobody lingers long enough to stack",
      "fontSize": 13,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.965Z",
      "updatedAt": "2026-08-29T18:37:19.965Z",
