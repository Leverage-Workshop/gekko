      "type": "text",
      "x": 60,
      "y": 122,
      "strokeColor": "#e03131",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "ABSORPTION  —  a block",
      "fontSize": 19,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:37:19.964Z",
      "updatedAt": "2026-08-29T18:37:19.964Z",
      "version": 1
