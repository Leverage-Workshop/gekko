      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945435090,
      "link": null,
      "locked": false,
      "text": "Resting orders never move price on\ntheir own. They are an offer to trade\nif you come to me.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Resting orders never move price on\ntheir own. They are an offer to trade\nif you come to me.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m_c2",
      "type": "text",
      "x": 482,
      "y": 412,
      "width": 258.78125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 2139917725,
      "version": 2,
      "versionNonce": 409940893,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945435090,
      "link": null,
      "locked": false,
      "text": "With nothing left to sell to, price\nshould now tick up. That is what\nnormally happens.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With nothing left to sell to, price\nshould now tick up. That is what\nnormally happens.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m_c3",
      "type": "text",
      "x": 902,
      "y": 412,
      "width": 292.1953125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 2005034675,
      "version": 2,
      "versionNonce": 1342513331,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945435090,
      "link": null,
      "locked": false,
      "text": "Instead the wall is back, same price,\nwithin a second. Eat it again — back\nagain. THIS is refreshing.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instead the wall is back, same price,\nwithin a second. Eat it again — back\nagain. THIS is refreshing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
