      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Resting orders at a price get completely eaten — and more of them immediately show up at the same price. Price does not move.",
      "autoResize": true,
      "lineHeight": 1.25
    },
