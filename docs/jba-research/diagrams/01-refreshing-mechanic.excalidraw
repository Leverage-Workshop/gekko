      "text": "WHY IT MATTERS    ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHY IT MATTERS",
      "autoResize": true,
      "lineHeight": 1.25,
      "updatedAt": "2026-08-28T19:31:19.743Z"
    },
    {
      "id": "m_b1t",
      "type": "text",
      "x": 64,
      "y": 678,
      "width": 442.2734375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 973561747,
      "version": 2,
      "versionNonce": 1561090451,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787945435090,
      "link": null,
      "locked": false,
      "text": "A single big order tells you almost nothing — it could\nbe a mistake, a hedge, or about to be cancelled.\n\nRefreshing tells you someone is COMMITTED. They\ndidn't just place size once; they got run over and came\nback. They are defending this price on purpose, and\nthey have the inventory to keep doing it.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A single big order tells you almost nothing — it could\nbe a mistake, a hedge, or about to be cancelled.\n\nRefreshing tells you someone is COMMITTED. They\ndidn't just place size once; they got run over and came\nback. They are defending this price on purpose, and\nthey have the inventory to keep doing it.",
      "autoResize": true,
      "lineHeight": 1.25
    },
