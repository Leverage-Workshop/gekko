    {
      "id": "j_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "The last five sessions' value zones, chained where they overlap, boxed as one zone. Real numbers: NQU6, exported 2026-08-23, job-study-daily.json.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-09-06T19:22:56.720Z",
      "updatedAt": "2026-09-06T19:22:56.720Z",
      "version": 1
    },
