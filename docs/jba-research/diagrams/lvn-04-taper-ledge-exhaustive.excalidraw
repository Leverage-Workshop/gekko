  "elements": [
    {
      "id": "tl_title",
      "type": "text",
      "x": 40,
      "y": 30,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Three ways a profile extreme can end — and only one means unfinished",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.191Z",
      "updatedAt": "2026-08-30T20:45:50.191Z",
      "version": 1
    },
    {
      "id": "tl_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "width": 1120,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Read the top and the bottom of every profile for one of these three. Two of them say the auction is done. The third says it is not, and it is the one that should smack you in the face.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.191Z",
      "updatedAt": "2026-08-30T20:45:50.191Z",
      "version": 1
    },
    {
      "id": "tl_pa",
      "type": "text",
      "x": 100,
      "y": 114,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "TAPER",
      "fontSize": 19,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.191Z",
      "updatedAt": "2026-08-30T20:45:50.191Z",
      "version": 1
    },
    {
      "id": "tl_pb",
      "type": "text",
      "x": 480,
      "y": 114,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "EXHAUSTIVE NODE",
      "fontSize": 19,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.191Z",
      "updatedAt": "2026-08-30T20:45:50.191Z",
      "version": 1
    },
