      "version": 1
    },
    {
      "id": "tl_vat",
      "type": "text",
      "x": 114,
      "y": 358,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Volume falls away PROGRESSIVELY\naway from the fat node — parabolic,\nor a straight 45-degree ramp.\n\nkind: taper-tail      FINISHED",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    },
    {
      "id": "tl_vb",
      "type": "rectangle",
      "x": 480,
      "y": 346,
      "width": 280,
      "height": 104,
      "backgroundColor": "#e9ecef",
      "strokeColor": "#868e96",
      "strokeWidth": 1,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    },
    {
      "id": "tl_vbt",
      "type": "text",
      "x": 494,
      "y": 358,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A spike, then a small build on it,\nthen it IMMEDIATELY steps off\nto nothing.\n\nkind: exhaustive-node   FINISHED",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    },
    {
      "id": "tl_vc",
      "type": "rectangle",
      "x": 840,
      "y": 346,
      "width": 280,
      "height": 104,
      "backgroundColor": "#ffe3e3",
      "strokeColor": "#e03131",
      "strokeWidth": 1,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    },
    {
      "id": "tl_vct",
      "type": "text",
      "x": 854,
      "y": 358,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A stack of near-EQUAL bars.\nThe build just stopped. Neither a\ntaper nor an exhaustive node.\n\nshape: ledge     unfinished = TRUE",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    },
    {
      "id": "tl_q",
      "type": "rectangle",
      "x": 100,
      "y": 470,
      "width": 1020,
      "height": 82,
      "backgroundColor": "#e9ecef",
      "strokeColor": "#868e96",
      "strokeWidth": 1,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    },
    {
      "id": "tl_qt",
      "type": "text",
      "x": 118,
      "y": 482,
      "strokeColor": "#495057",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"that looks like bit of a parabolic taper or you can also have a 45 degree taper\"      \"we come to the edge of a profile we have a firm uh clean\ndistribution nice LVN and it immediately steps off\"      \"we have a volume build and then we basically have a flat line let it smack you in the\nface ... it's should stand out to you you shouldn't have to squint your eyes to see it\"      — Volume Profile 101, lines 44-48, 328-335, 403-414",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
      "updatedAt": "2026-08-30T20:45:50.192Z",
      "version": 1
    }
