    {
      "id": "tl_va",
      "type": "rectangle",
      "x": 100,
      "y": 346,
      "width": 280,
      "height": 104,
      "backgroundColor": "#e9ecef",
      "strokeColor": "#868e96",
      "strokeWidth": 1,
      "roughness": 0,
      "fontSize": 20,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:45:50.192Z",
