    {
      "id": "s_calltx",
      "type": "text",
      "x": 668,
      "y": 688,
      "strokeColor": "#343a40",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"At which point in that flip, that pock flip, from my end,\nyou still have an execution trigger.\"      — 07-17 @02:04",
      "fontSize": 14,
