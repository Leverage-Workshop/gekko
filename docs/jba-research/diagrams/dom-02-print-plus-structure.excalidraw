      "type": "text",
      "x": 432,
      "y": 386,
      "strokeColor": "#2b8a3e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "RISK MANAGED — this is the trade",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:54:39.305Z",
      "updatedAt": "2026-08-29T18:54:39.305Z",
      "version": 1
    },
