    },
    {
      "id": "p_bC",
      "type": "text",
      "x": 784,
      "y": 298,
      "width": 330,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Every setting fires at once and price\nhas already burst up and out through\nthe level. The evidence is real; the\nentry is not.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:54:39.305Z",
      "updatedAt": "2026-08-29T18:54:39.305Z",
      "version": 1
    },
