      "x": 432,
      "y": 246,
      "strokeColor": "#2b8a3e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A LEVEL YOU DREW FIRST",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:54:39.305Z",
      "updatedAt": "2026-08-29T18:54:39.305Z",
      "version": 1
    },
    {
      "id": "p_bB",
      "type": "text",
      "x": 414,
      "y": 298,
      "width": 330,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "MGI, an LVN, prior day's high or low,\nthe overnight low, the RP. The level\ngives you the stop; the print gives you\nthe moment.",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:54:39.305Z",
      "updatedAt": "2026-08-29T18:54:39.305Z",
      "version": 1
    },
    {
