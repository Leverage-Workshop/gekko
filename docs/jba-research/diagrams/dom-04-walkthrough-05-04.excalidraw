  "elements": [
    {
      "id": "w_title",
      "type": "text",
      "x": 40,
      "y": 30,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "05-04 at the overnight low: the arrows printed down, the trade was long",
      "fontSize": 26,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:57:33.084Z",
      "updatedAt": "2026-08-29T18:57:33.084Z",
      "version": 1
    },
    {
      "id": "w_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A Dominator print marks where a side spent itself — not where it was going to win.",
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:57:33.084Z",
      "updatedAt": "2026-08-29T18:57:33.084Z",
      "version": 1
    },
    {
      "id": "w_foot",
      "type": "text",
      "x": 40,
      "y": 400,
      "strokeColor": "#495057",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Effort with no result, at a level that was recovered. The prints told him the sellers had spent themselves — they did not tell him to sell.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:57:33.085Z",
      "updatedAt": "2026-08-29T18:57:33.085Z",
      "version": 1
    },
