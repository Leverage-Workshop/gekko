    },
    {
      "id": "w_c5b",
      "type": "text",
      "x": 932,
      "y": 324,
      "width": 205,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"Sweep cell sweep in progress.\nNo progress.\" The fail — and\nonly now does he look at the\nladder. Long.",
      "fontSize": 12.5,
