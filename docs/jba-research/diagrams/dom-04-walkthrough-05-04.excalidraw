      "x": 948,
      "y": 284,
      "strokeColor": "#2b8a3e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "5    @25:24",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-29T18:57:33.085Z",
      "updatedAt": "2026-08-29T18:57:33.085Z",
