# Node / Next.js (for the app scaffolded in feat-001)
node_modules/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
/.pnp
.pnp.*
*.pem

# Env & secrets
.env
.env.*
!.env.example

# Tooling caches / deploy
.vercel/
.trigger/
*.log
.DS_Store

# Autonomous orchestration loop (scripts/auto-implement.sh) per-session logs
logs/auto-run/
chart-data/lvn-fixtures/fixture-x.vbp.md

# Local Claude Code settings (contains secrets)
.claude/settings.local.json
langsmith-prompt-review/

# Transient git worktrees for parallel Claude Code subagents. Each is a full
# checkout with its own node_modules (~900 MB) and is removed when the agent
# finishes — never commit them.
.claude/worktrees/

# Python bytecode from the JBA research helper
__pycache__/
*.pyc

# Derived reading copies of replay transcripts
docs/jba-research/replays/.condensed/

# Codex review gate stamp (scripts/codex-gate.ts) — bound to a local HEAD,
# never meaningful in another checkout.
.codex-gate/

# job-lvn-golden: the operator's live exporter output staged in the golden root
# (only <YYYY-MM-DD>/ folders are golden dates)
chart-data/job-lvn-golden/*.vbp.md
chart-data/job-lvn-golden/es/
chart-data/job-lvn-golden/nq/
