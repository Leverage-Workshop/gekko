    {
      "id": "sv_c2t",
      "type": "text",
      "x": 544,
      "y": 380,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Report TWO nodes, adjacent.\nkind: hvn-edge (the cliff)  +  kind: lvn (the shelf)\nEdge and shelf are one structure with two halves —\nthe plan leans on both.",
      "fontSize": 15,
      "fontFamily": 5,
