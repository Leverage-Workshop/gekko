      "y": 30,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Shelf-edge vs valley: two shapes, two different reports",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:44:27.107Z",
      "updatedAt": "2026-08-30T20:44:27.107Z",
      "version": 1
    },
    {
      "id": "sv_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "width": 1120,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "A trough between two fat nodes is ONE node. A thin shelf just outside a single node's boundary is TWO — the edge and the shelf are reported separately.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:44:27.107Z",
      "updatedAt": "2026-08-30T20:44:27.107Z",
      "version": 1
    },
    {
