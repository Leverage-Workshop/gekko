      "type": "text",
      "x": 54,
      "y": 194,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Locally deep — under half\nits neighbours. But the tip is\nstill far from the axis.\nNOT the primary.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:39:50.474Z",
      "updatedAt": "2026-08-30T20:39:50.474Z",
