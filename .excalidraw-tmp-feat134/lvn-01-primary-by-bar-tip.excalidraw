      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Finding the primary: bar tip, not local depth",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:39:50.468Z",
      "updatedAt": "2026-08-30T20:39:50.468Z",
      "version": 1
    },
    {
      "id": "bt_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "width": 1060,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Bars grow LEFT from the price axis. The primary is the trough whose tips sit nearest the axis — measured against the whole image, not its two neighbours.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:39:50.469Z",
      "updatedAt": "2026-08-30T20:39:50.469Z",
      "version": 1
