    {
      "id": "dw_qtxt1",
      "type": "text",
      "x": 58,
      "y": 542,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "1 hump = bell        2 humps = double        3 or more = multi",
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    },
    {
      "id": "dw_qtxt2",
      "type": "text",
      "x": 58,
      "y": 572,
      "strokeColor": "#495057",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "\"here's a primary obn right there and one right here so between the two we have a distribution of volume\"\n\"the out sides that it's not escaping are the lvns because when it escapes it's can head into the next distribution\"   — Volume Profile 101, lines 95-99 and 142-148",
      "fontSize": 14,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    }
