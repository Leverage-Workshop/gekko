    {
      "id": "dw_title",
      "type": "text",
      "x": 40,
      "y": 30,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Distributions are the zones BETWEEN primary LVNs",
      "fontSize": 28,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    },
    {
      "id": "dw_sub",
      "type": "text",
      "x": 40,
      "y": 70,
      "width": 1080,
      "strokeColor": "#868e96",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "Count the humps first. The primary sits on a wall between humps, never inside one — and a shallower secondary trough does not split a distribution.",
      "fontSize": 16,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    },
