    {
      "id": "dw_badge",
      "type": "text",
      "x": 745,
      "y": 126,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "2 humps\n→ profileShape: double",
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    },
    {
      "id": "dw_l1",
      "type": "text",
      "x": 745,
      "y": 212,
      "strokeColor": "#1971c2",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "DISTRIBUTION 1\nthe zone one auction lived in",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    },
    {
      "id": "dw_l2",
      "type": "text",
      "x": 745,
      "y": 348,
      "strokeColor": "#2f9e44",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "THE WALL between them\n= the PRIMARY LVN",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
    },
