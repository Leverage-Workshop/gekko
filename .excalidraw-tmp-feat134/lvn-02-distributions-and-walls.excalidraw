    {
      "id": "dw_ctxt",
      "type": "text",
      "x": 54,
      "y": 238,
      "strokeColor": "#1e1e1e",
      "strokeWidth": 2,
      "roughness": 0,
      "text": "SECONDARY — shallower,\nand INSIDE the hump.\nStill reported, rank 3-5.\nDoes not split anything.",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-08-30T20:42:53.580Z",
      "updatedAt": "2026-08-30T20:42:53.580Z",
      "version": 1
